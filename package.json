{
  "name": "rains-or-gains",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "dev": "npm run build:web && wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "migrate": "wrangler d1 migrations apply rain-or-gains --remote",
    "export": "node scripts/export.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "tail": "wrangler tail",
    "types": "wrangler types --strict-vars=false",
    "check": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run"
  },
  "devDependencies": {
    "@observablehq/plot": "^0.6.19",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "esbuild@0.28.2": true
  }
}
